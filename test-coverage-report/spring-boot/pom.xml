<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vanillabp</groupId>
    <artifactId>cibseven-adapter-test-coverage-report</artifactId>
    <version>2.0.0-2.2-SNAPSHOT</version>
  </parent>

  <artifactId>cibseven-adapter-spring-boot-report</artifactId>
  <packaging>pom</packaging>
  <name>VanillaBP CIB seven adapter - Test coverage report - Spring Boot</name>
  <description>Aggregated test coverage of the CIB seven adapter's platform-neutral core and its Spring Boot integration.</description>

  <dependencies>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>cibseven-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>cibseven-adapter-spring-boot</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>cibseven-adapter-spring-boot-webapps</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>cibseven-adapter-integration-tests</artifactId>
      <version>${project.version}</version>
      <!-- test-only module without main sources: it produces no jar, so depend on
           its POM. 'report-aggregate' resolves the reactor project by groupId and
           artifactId and still picks up its 'jacoco.exec'. -->
      <type>pom</type>
    </dependency>
    <dependency>
      <groupId>io.vanillabp</groupId>
      <artifactId>cibseven-adapter-migration-tests</artifactId>
      <version>${project.version}</version>
      <!-- the tests which run the Camunda 7 adapter next to this one, a module only this
           repository has. Test-only as well, so the POM, like above. -->
      <type>pom</type>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <!-- nothing to deploy - report is published on Github pages -->
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <goals>
              <!-- 'report-aggregate' sums up all '*.exec' files found in the modules listed in <dependencies> into one report -->
              <goal>report-aggregate</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <outputDirectory>${project.basedir}/report</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
